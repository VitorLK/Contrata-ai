# Copie este arquivo para ".env" e preencha com os seus valores.
# NUNCA cometa o arquivo ".env" real no Git (ele já está no .gitignore).

PORT=3000

# Troque SUA_SENHA pela senha que você definiu na instalação do PostgreSQL.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/tcc_freelancers

# Troque por uma string aleatória e secreta (ex.: gere com `openssl rand -hex 32`).
JWT_SECRET=troque_por_um_segredo_forte

# Busca de endereços. Para produção, troque por um provedor com SLA ou por
# uma instância própria e informe um User-Agent identificável.
GEOCODING_URL=https://nominatim.openstreetmap.org/search
MAP_USER_AGENT=ContrataAi-TCC/1.0 (academic service marketplace)
